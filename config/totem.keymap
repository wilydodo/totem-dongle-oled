#include "keys_nb.h"
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define Base        0
#define NNav        1
#define Num         2
#define Sym         3
#define Media       4
#define Meta        5
#define Gameing     6

&mt {
    quick-tap-ms = <100>;
    global-quick-tap;
    flavor = "tap-preferred";
    tapping-term-ms = <170>;
};

&lt {
    tapping-term-ms = <240>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <250>;
            quick-tap-ms = <125>;
            global-quick-tap;
            bindings = <&kp>, <&kp>;
        };
    };

    combos {
        compatible = "zmk,combos";

        grave {
            bindings = <&hm ESC GRAVE>;
            key-positions = <0 1>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Main {
            bindings = <
        &kp Q        &kp W           &kp F           &kp P             &kp B        &kp J        &kp L              &kp U            &kp Y            &kp SEMI
        &hm LCTRL A  &hm LEFT_ALT R  &hm LEFT_GUI S  &hm LEFT_SHIFT T  &kp G        &kp M        &hm RIGHT_SHIFT N  &hm RIGHT_GUI E  &hm RIGHT_ALT I  &hm LCTRL O
&trans  &kp Z        &kp X           &kp C           &kp D             &kp V        &kp K        &kp H              &kp COMMA        &kp DOT          &kp FSLH     &trans
                                     &kp DELETE      &lt 3 DELETE      &kp SPACE    &lt 1 ENTER  &lt 2 BACKSPACE    &kp BACKSPACE
            >;

            label = "Main";
        };

        Num {
            bindings = <
       &kp GRAVE  &none   &none   &none       &kp LBKT          &kp RBKT  &none   &none   &kp MINUS  &kp EQUAL
       &kp N1     &kp N2  &kp N3  &kp N4      &kp N5            &kp N6    &kp N7  &kp N8  &kp N9     &kp N0
&none  &none      &none   &none   &none       &none             &none     &none   &none   &none      &kp BSLH   &none
                          &none   &kp DELETE  &kp LEFT_SHIFT    &none     &none   &none
            >;
        };

        Fun {
            bindings = <
       &none      &none     &none     &none      &none          &kp PG_UP        &kp F1  &kp F2   &kp F3   &kp F4
       &kp LCTRL  &kp LALT  &kp LGUI  &kp LSHFT  &kp HOME       &kp PRINTSCREEN  &kp F5  &kp F6   &kp F7   &kp F8
&none  &none      &none     &none     &none      &none          &kp PAGE_DOWN    &kp F9  &kp F10  &kp F11  &kp F12  &none
                            &none     &none      &lt 0 SPACE    &none            &none   &none
            >;
        };

        Nav {
            bindings = <
       &none  &mkp LCLK  &mkp MCLK  &mkp RCLK  &none    &none  &mkp LCLK       &mkp MCLK       &mkp RCLK        &none
       &none  &kp LEFT   &kp UP     &kp RIGHT  &none    &none  &mmv MOVE_LEFT  &mmv MOVE_UP    &mmv MOVE_RIGHT  &none
&none  &none  &mkp MB4   &kp DOWN   &mkp MB5   &none    &none  &mkp MB4        &mmv MOVE_DOWN  &mkp MB5         &none  &none
                         &none      &none      &none    &none  &none           &none
            >;
        };
    };

    conditional_layers { compatible = "zmk,conditional-layers"; };
};
